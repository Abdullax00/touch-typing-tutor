# Автоматическая обработка окончаний строк
* text=auto

# Исходный код и веб-файлы
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cs text eol=crlf
*.bat text eol=crlf

# Бинарные файлы (медиа, иконки, исполняемые файлы)
*.exe binary
*.ico binary
*.png binary
*.mp4 binary
*.zip binary
